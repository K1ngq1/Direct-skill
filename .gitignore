# Only public source is tracked; private production data stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/package.json
!/requirements.txt
!/distribution/
!/storyboard-workbench/
!/docs/
/docs/*
!/docs/FIRST-RELEASE.md
!/docs/MEDIA-PIPELINE-VERIFICATION.md
!/docs/PROMPT-LANGUAGE-VERIFICATION.md
!/.github/
/.github/*
!/.github/workflows/
!/.agents/
!/.claude/
!/.codebuddy/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/storyboard-workbench/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/storyboard-workbench/
/.codebuddy/*
!/.codebuddy/skills/
/.codebuddy/skills/*
!/.codebuddy/skills/storyboard-workbench/
**/__pycache__/
**/*.pyc
**/node_modules/
**/.env
**/.env.*
**/*.lock
**/*.tmp

# Private-project and historical browser checks remain local.
/storyboard-workbench/tests/*
!/storyboard-workbench/tests/fixtures/
!/storyboard-workbench/tests/runtime.test.mjs
!/storyboard-workbench/tests/visual.test.mjs
!/storyboard-workbench/tests/visual-v2.test.mjs
!/storyboard-workbench/tests/visual-v2-export.test.mjs
!/storyboard-workbench/tests/generation.test.mjs
!/storyboard-workbench/tests/generation-batch.test.mjs
!/storyboard-workbench/tests/generation-pipeline.test.mjs
!/storyboard-workbench/tests/generation-bridge.test.mjs
!/storyboard-workbench/tests/libtv-assets.test.mjs
!/storyboard-workbench/tests/libtv-generation.test.mjs
!/storyboard-workbench/tests/libtv-generation-store.test.mjs
!/storyboard-workbench/tests/libtv-delivery.test.mjs
!/storyboard-workbench/tests/libtv-image-file.test.mjs
!/storyboard-workbench/tests/video.test.mjs
!/storyboard-workbench/tests/excel-delivery.test.mjs
!/storyboard-workbench/tests/patch-excel.test.mjs
!/storyboard-workbench/tests/scene-art.test.mjs
!/storyboard-workbench/tests/excel-export.test.mjs
!/storyboard-workbench/tests/test_import.py
!/storyboard-workbench/tests/test_import_mapping.py
!/storyboard-workbench/tests/verify-excel.py
!/storyboard-workbench/tests/release.test.mjs
